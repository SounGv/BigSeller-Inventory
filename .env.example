# BigSeller
BIGSELLER_BASE_URL=https://www.bigseller.com
BIGSELLER_INVENTORY_URL=https://www.bigseller.com/web/inventory/warehouseInventory.htm
BIGSELLER_SALES_URL=https://www.bigseller.com/web/statis/items.htm
BIGSELLER_SKU_INVENTORY_URL=https://www.bigseller.com/web/inventory/index.htm
BIGSELLER_MOVING_GOODS_URL=https://www.bigseller.com/web/inventory/movingGoods/index.htm
BIGSELLER_SKU_SALES_URL=https://www.bigseller.com/web/statis/warehouse/saleout.htm
BIGSELLER_RETURN_URL=https://www.bigseller.com/web/order/inwarehouse/index.htm
BIGSELLER_CANCELLED_URL=https://www.bigseller.com/web/order/index.htm?status=In%20Cancel
# Path to the saved Playwright storage state (session). Created by `npm run login:bigseller`.
# This file itself is NEVER committed (see .gitignore) and never contains a plaintext password.
BIGSELLER_AUTH_STATE_PATH=playwright/.auth/bigseller.json

# Inventory filter selection (must match the exact labels shown in the BigSeller UI)
INVENTORY_WAREHOUSE_NAME=
# Optional — leave blank to include all areas within the selected warehouse.
INVENTORY_AREA_NAME=
INVENTORY_POSITION_TYPE_NAME=ตำแหน่งหยิบสินค้า
# Position type treated as a replenishment SOURCE by the transfer-plan feature (Phase 4).
SOURCE_POSITION_TYPE_NAME=ตำแหน่งจัดเก็บสินค้า

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path to a Google service-account JSON key file. Never commit this file (see .gitignore -> secrets/).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Sheet tab names (existing database system)
SHEET_LOCATION_SNAPSHOT=DB_LOCATION_SNAPSHOT
SHEET_LOCATION_CURRENT=DB_LOCATION_CURRENT
SHEET_SKU_INVENTORY=DB_SKU_INVENTORY
SHEET_SYNC_LOG=SYNC_LOG
SHEET_ERROR_LOG=ERROR_LOG
SHEET_EMPLOYEE_TASK_VIEW=EMPLOYEE_TASK_VIEW
SHEET_REPLENISH_TRANSACTION=DB_REPLENISH_TRANSACTION
SHEET_SALES_SNAPSHOT=DB_SALES_SNAPSHOT
SHEET_TRANSFER_PLAN=DB_TRANSFER_PLAN
SHEET_TRANSFER_EXCEPTION=TRANSFER_EXCEPTION
SHEET_TRANSFER_NOTIFICATION_LOG=TRANSFER_NOTIFICATION_LOG
SHEET_SKU_SALES=DB_SKU_SALES
# Manually-maintained reference table (sku, unitsPerCarton) — NOT synced from
# BigSeller. Fill in per SKU to enable whole-carton rounding for replenishment
# targets in carton-eligible zones (see CARTON_ZONE_PREFIXES in
# transfer-plan-service.ts). A SKU with no row here is unaffected.
SHEET_SKU_CARTON_QTY=DB_SKU_CARTON_QTY

# Returns reconciliation (Phase 1) — see FEATURE-returns-reconciliation-phase1.md
SHEET_RETURN_CURRENT=DB_RETURN_CURRENT
SHEET_RETURN_STATUS_LOG=DB_RETURN_STATUS_LOG
# Optional: write the returns job (the two tabs above + SYNC_LOG + ERROR_LOG) into this
# workbook instead of GOOGLE_SHEETS_SPREADSHEET_ID. Those four tabs must already exist
# there with their header rows.
GOOGLE_SHEETS_RETURNS_ID=
# Days since the after-sale request was filed before an unresolved REFUNDED/ACCEPTED
# row flags as overdue (per platform — see §12 for how these defaults were chosen).
RETURN_STOCKIN_OVERDUE_DAYS_SHOPEE=8
RETURN_STOCKIN_OVERDUE_DAYS_TIKTOK=10
RETURN_STOCKIN_OVERDUE_DAYS_LAZADA=14
# Keep false until เวลาครบกำหนด's real meaning for TikTok/Lazada is confirmed against
# each platform's own Seller Center (§10 — not yet verified as of Phase 1).
RETURN_DUE_SOON_ENABLED=false

# Cancelled-orders tracking — writes into tabs in a SEPARATE team-report
# workbook, not the main GOOGLE_SHEETS_SPREADSHEET_ID above. Required for
# `npm run sync:cancelled-orders`; leave unset everywhere else. Split into two
# tabs by whether stock was actually deducted (ล็อคแล้ว/ตัด) before cancellation.
GOOGLE_SHEETS_TEAM_REPORT_ID=
SHEET_CANCELLED_DEDUCTED_TAB=รายงานยกเลิกคำสั่งซื้อรายวัน
SHEET_CANCELLED_NOT_DEDUCTED_TAB=รายงานยกเลิกคำสั่งซื้อรายวัน (ยังไม่ตัดสต็อก)

# Safety switch: when true, sync scripts only extract + validate, never write to Google Sheets
DRY_RUN=true

# Transfer-plan feature (Phase 6-9) safety gate — separate from DRY_RUN above,
# which only controls Google Sheets writes. MOVE_DRY_RUN=true means
# export/preview only, never touching BigSeller's real "นำเข้า" button.
# Flip AUTO_IMPORT=true only when you intend a real, live import run.
MOVE_DRY_RUN=true
AUTO_IMPORT=false
MOVE_OUTPUT_DIR=output/move-import
# Best-seller remark on each transfer document — pulls "รายงาน SKU Merchant"
# for this time window and writes a ranked avg-daily-sales note into each
# document's "หมายเหตุ" field after it's created. Set to false to skip.
SKU_SALES_WINDOW_LABEL=15 วัน
SET_SALES_REMARK=true

# Overrides auto-detecting the latest successful sync run — leave unset for normal use.
# RUN_ID=

# LINE notification (fires after a successful import:moves) — LINE Notify was
# shut down by LINE in March 2025; this uses the LINE Messaging API instead.
LINE_CHANNEL_ACCESS_TOKEN=
# From LINE Developers Console > your channel > Basic settings tab.
LINE_CHANNEL_SECRET=
# See docs/line-group-id.md for how to find this. Never guess it and never use the chat.line.biz URL as this value.
LINE_GROUP_ID=
LINE_BOT_NAME=GV Inventory Bot
# Safety gate — leave false until "npm run line:test" is confirmed working in the real group.
LINE_NOTIFY_ENABLED=false

# LINE command-bot (scripts/line-command-bot.ts) — lets whitelisted staff tag
# the bot in the group to trigger the full sync->import pipeline. Comma-
# separated LINE userIds (find them the same way as LINE_GROUP_ID: a
# temporary capture script logging event.source.userId from a real message).
# Runs a real, live BigSeller import with AUTO_IMPORT=true and no extra
# confirmation step — keep this list to genuinely authorized staff only.
LINE_COMMAND_ALLOWED_USER_IDS=
LINE_COMMAND_BOT_PORT=3001

# Local paths
DOWNLOAD_DIR=./tmp
LOG_DIR=./logs

# Retry policy
MAX_RETRIES=2

# Confirmed live: running the sync browser headless gets flagged by BigSeller's bot
# detection and the session gets silently kicked mid-run. Keep this false (headed)
# unless you've separately verified headless stays logged in for your account.
BIGSELLER_HEADLESS=false

# `npm run keep-alive` (scripts/session-keeper.ts, see HANDOFF-SESSION-BUG.md) —
# how often it pings BigSeller and re-saves playwright/.auth/bigseller.json.
# Ported from the sibling BigSeller-Inventory project, where 8 min survived
# 64+ minutes with zero session expiries. Always headless regardless of
# BIGSELLER_HEADLESS above — that setting is about extended multi-click sync
# runs, not a single lightweight ping (hasValidSession's pre-flight check in
# browser-runner.ts already does the same).
SESSION_KEEPER_INTERVAL_MINUTES=8
