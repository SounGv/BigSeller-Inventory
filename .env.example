# BigSeller
BIGSELLER_BASE_URL=https://www.bigseller.com
BIGSELLER_INVENTORY_URL=https://www.bigseller.com/web/inventory/warehouseInventory.htm
BIGSELLER_SALES_URL=https://www.bigseller.com/web/statis/items.htm
BIGSELLER_SKU_INVENTORY_URL=https://www.bigseller.com/web/inventory/index.htm
BIGSELLER_MOVING_GOODS_URL=https://www.bigseller.com/web/inventory/movingGoods/index.htm
BIGSELLER_SKU_SALES_URL=https://www.bigseller.com/web/statis/warehouse/saleout.htm
# Path to the saved Playwright storage state (session). Created by `npm run login:bigseller`.
# This file itself is NEVER committed (see .gitignore) and never contains a plaintext password.
BIGSELLER_AUTH_STATE_PATH=playwright/.auth/bigseller.json

# Inventory filter selection (must match the exact labels shown in the BigSeller UI)
INVENTORY_WAREHOUSE_NAME=
# Optional — leave blank to include all areas within the selected warehouse.
INVENTORY_AREA_NAME=
INVENTORY_POSITION_TYPE_NAME=ตำแหน่งหยิบสินค้า
# Position type treated as a replenishment SOURCE by the transfer-plan feature (Phase 4).
SOURCE_POSITION_TYPE_NAME=ตำแหน่งจัดเก็บสินค้า

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path to a Google service-account JSON key file. Never commit this file (see .gitignore -> secrets/).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Sheet tab names (existing database system)
SHEET_LOCATION_SNAPSHOT=DB_LOCATION_SNAPSHOT
SHEET_LOCATION_CURRENT=DB_LOCATION_CURRENT
SHEET_SKU_INVENTORY=DB_SKU_INVENTORY
SHEET_SYNC_LOG=SYNC_LOG
SHEET_ERROR_LOG=ERROR_LOG
SHEET_EMPLOYEE_TASK_VIEW=EMPLOYEE_TASK_VIEW
SHEET_REPLENISH_TRANSACTION=DB_REPLENISH_TRANSACTION
SHEET_SALES_SNAPSHOT=DB_SALES_SNAPSHOT
SHEET_TRANSFER_PLAN=DB_TRANSFER_PLAN
SHEET_TRANSFER_EXCEPTION=TRANSFER_EXCEPTION
SHEET_TRANSFER_NOTIFICATION_LOG=TRANSFER_NOTIFICATION_LOG
SHEET_SKU_SALES=DB_SKU_SALES
# Manually-maintained reference table (sku, unitsPerCarton) — NOT synced from
# BigSeller. Fill in per SKU to enable whole-carton rounding for replenishment
# targets in carton-eligible zones (see CARTON_ZONE_PREFIXES in
# transfer-plan-service.ts). A SKU with no row here is unaffected.
SHEET_SKU_CARTON_QTY=DB_SKU_CARTON_QTY

# Manually-maintained warehouse stock-count workbook (บันทึกสต๊อก_เดือนXX...) —
# owned/edited by ฝ่ายคลัง staff, NOT synced from BigSeller. A raw .xlsx file
# in Drive (not a native Google Sheet), so it's read via the Drive API +
# `xlsx` and needs its OWN sharing grant to the service account (Viewer is
# enough) — being shared on GOOGLE_SHEETS_SPREADSHEET_ID above does nothing
# for this file. Also requires the Drive API enabled on this GCP project
# (separate toggle from the Sheets API, which was already on).
GOOGLE_DRIVE_STOCK_COUNT_FILE_ID=

# Supabase (FEATURE-web-dashboard-supabase.md) — dual-write target for the GV
# Ops Console reporting dashboard, alongside the Google Sheets writes above.
# OPTIONAL: order-demand-service.ts (and future services) skip the Supabase
# write silently if these are blank, so this never blocks the existing
# Sheets-only pipeline. Service ROLE key only — never the anon/publishable
# key — this runs server-side and must bypass the dashboard's SELECT-only RLS
# policy. Get both from the Supabase dashboard: Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wave shipping-label batch print (FEATURE-branch-grouped-batch-print.md) —
# confirmed 2026-09-09: staff already confirm orders and create the Wave by
# hand (one Wave per COM 7 branch batch); this only automates the last step
# (select every listed Wave for WAVE_PRINT_STORE_NAME, click "พิมพ์ใบปะหน้าพัสดุ").
# Leave AUTO_PRINT_WAVES unset/false for a dry run (selects + reports the
# count, never clicks print) — same safety gate pattern as AUTO_IMPORT above.
WAVE_PRINT_STORE_NAME=COM 7
WAVE_PRINT_TAB_NAME=รอหยิบสินค้า
AUTO_PRINT_WAVES=false

# BigSeller-WaveEngine — auto confirm + auto wave priority engine
# (BigSeller-WaveEngine/FEATURE-auto-confirm-and-wave-priority-engine.md).
# Priority order and per-channel timing live in src/wave-engine/channel-policy.ts
# (12 channels, set 2026-09-11):
#   1 Express Delivery (SPX)   2 ส่งทันที 2 ชม.   3 SHP Food
#   4 BEST Express + DHL Domestic (the one pair allowed to share a wave)
#   5-12 LEX TH, SPX Express, TikTok J&T, TikTok Flash, Lazada Flash,
#        SPX(TH), KEX, Flash Bulky
# Truck times: Shopee 16:01, Lazada 13:01, TikTok 14:01 — taken from each
# channel's own name prefix.
# Run `npm run keep-alive` alongside the engine — it owns the session file;
# the engine only reads it.
BIGSELLER_NEW_ORDERS_URL=https://www.bigseller.com/web/order/index.htm?status=new
BIGSELLER_GENERATE_WAVE_URL=https://www.bigseller.com/web/waveShip/wave/generatedWave.htm
# The ONLY priorities allowed to click for real, e.g. "2" or "1,2". Blank = a
# full dry run, which is the default and the only safe starting point: leave it
# blank until a day of logs/wave-engine-YYYY-MM-DD.jsonl has been spot-checked
# against what a human operator would have done. Going live is a per-priority
# decision — approving the instant channel says nothing about Shopee Food.
WAVE_ENGINE_LIVE_PRIORITIES=
# Caps how many orders one cycle may confirm. Use 1 for a first live run so a
# person can check the result before it happens N more times. Blank = no cap.
WAVE_ENGINE_MAX_LIVE_CONFIRMS=
WAVE_ENGINE_URGENT_LOOP_MINUTES=3
WAVE_ENGINE_MAIN_LOOP_MINUTES=12
WAVE_ENGINE_JITTER_SECONDS=25
# Seller Delivery's end-of-day sweep. Blank = it never acts, which is the
# current state: every Seller Delivery row in the queue is a LockStock
# reservation, and the real ones carry no กำหนดส่ง date in the list view.
WAVE_ENGINE_END_OF_DAY_SWEEP=
WAVE_ENGINE_FORCED_TRIGGER=15:45
# Fires ONE real confirm-and-wave cycle at this clock time — unlike the two
# stubs above, this one actually runs (clicking wherever LIVE_PRIORITIES
# already allows it to), so a courier's Waves are already built BEFORE staff
# start their afternoon shift instead of them waiting on it (2026-09-14).
# Blank = disabled. "11:55" was given as an example ("เช่น"), not the team's
# confirmed shift-start time — set this to the real one before relying on it.
WAVE_ENGINE_PRE_SHIFT_TIME=
# Optional JSON file of {"Exact BigSeller label": {priority, rule}} merged over
# channel-policy.ts — the supported way to add a courier or change a truck time
# without a code change. An unmapped courier is always flagged for manual
# review, never auto-confirmed.
WAVE_ENGINE_CHANNEL_MAP_PATH=
# Only this warehouse holds sellable stock (confirmed 2026-09-10). An order
# allocated anywhere else — above all the decoy warehouse, which mirrors
# quantities of DAMAGED stock sitting in STOCK_5's ตำแหน่งชำรุด, see
# decoy-reconciliation-service.ts — is flagged so a human can move the goods.
# The wave engine never moves stock itself. Defaults follow
# INVENTORY_WAREHOUSE_NAME so this feature can't drift from the rest of the repo.
WAVE_ENGINE_PICKING_WAREHOUSE=STOCK_5
WAVE_ENGINE_DECOY_WAREHOUSE=STOCK_ซิงก์ขายออนไลน์
# Store whose orders are stock reservations (ของจอง) opened by sales to hold
# goods for a customer, not shipments. Never confirmed, never waved, and NOT
# counted as manual work — nobody has to do anything about them.
WAVE_ENGINE_RESERVED_STORE=LockStock
# The ONLY platforms this engine may act on. Everything else on BigSeller's
# platform filter — คำสั่งซื้อด้วยตนเอง, WooCommerce, POS, ทางแชท — belongs to
# another process and is skipped outright, not queued for anyone.
WAVE_ENGINE_ALLOWED_PLATFORMS=Shopee,Lazada,TikTok
# One wave is one picking trip to one FLOOR (FANTECH=5, Ugreen=3), so a wave is
# only worth creating once enough parcels are waiting. Judged per wave type,
# because effort per parcel differs: a single-SKU parcel is grab-and-pack, a
# multi-SKU one has to be picked and sorted per order.
WAVE_ENGINE_MIN_PARCELS_SINGLE=50
WAVE_ENGINE_MIN_PARCELS_MULTI=20
# Short loads are collected for this long (per carrier, measured from its own
# last wave) and then sent as one batch, so a trickle of orders never becomes a
# wave per order. Persisted in logs/wave-engine-state.json so one-shot runs
# batch the same way the daemon does.
WAVE_ENGINE_WAVE_INTERVAL_MINUTES=30
# How long to wait for BigSeller to reflect a confirmation before calling it
# unverified. 8s was too short and reported real confirmations as failures.
WAVE_ENGINE_CONFIRM_VERIFY_MS=30000
# An order the platform auto-cancels if left unconfirmed past its own
# "Expire ..." deadline loses the sale entirely — worse than any batching or
# truck-cutoff rule. Inside this many minutes of that deadline, the order
# jumps its own tier's queue instead of waiting (2026-09-14).
# Default is a guess (2 hours), not a number anyone gave — confirm or change it.
WAVE_ENGINE_EXPIRY_URGENT_MINUTES=120

# Safety switch: when true, sync scripts only extract + validate, never write to Google Sheets
DRY_RUN=true

# Transfer-plan feature (Phase 6-9) safety gate — separate from DRY_RUN above,
# which only controls Google Sheets writes. MOVE_DRY_RUN=true means
# export/preview only, never touching BigSeller's real "นำเข้า" button.
# Flip AUTO_IMPORT=true only when you intend a real, live import run.
MOVE_DRY_RUN=true
AUTO_IMPORT=false
MOVE_OUTPUT_DIR=output/move-import
# Best-seller remark on each transfer document — pulls "รายงาน SKU Merchant"
# for this time window and writes a ranked avg-daily-sales note into each
# document's "หมายเหตุ" field after it's created. Set to false to skip.
SKU_SALES_WINDOW_LABEL=15 วัน
SET_SALES_REMARK=true

# Overrides auto-detecting the latest successful sync run — leave unset for normal use.
# RUN_ID=

# LINE notification (fires after a successful import:moves) — LINE Notify was
# shut down by LINE in March 2025; this uses the LINE Messaging API instead.
LINE_CHANNEL_ACCESS_TOKEN=
# From LINE Developers Console > your channel > Basic settings tab.
LINE_CHANNEL_SECRET=
# See docs/line-group-id.md for how to find this. Never guess it and never use the chat.line.biz URL as this value.
LINE_GROUP_ID=
LINE_BOT_NAME=GV Inventory Bot
# Safety gate — leave false until "npm run line:test" is confirmed working in the real group.
LINE_NOTIFY_ENABLED=false

# LINE command-bot (scripts/line-command-bot.ts) — lets whitelisted staff tag
# the bot in the group to trigger the full sync->import pipeline. Comma-
# separated LINE userIds (find them the same way as LINE_GROUP_ID: a
# temporary capture script logging event.source.userId from a real message).
# Runs a real, live BigSeller import with AUTO_IMPORT=true and no extra
# confirmation step — keep this list to genuinely authorized staff only.
LINE_COMMAND_ALLOWED_USER_IDS=
LINE_COMMAND_BOT_PORT=3001

# Local paths
DOWNLOAD_DIR=./tmp
LOG_DIR=./logs

# Retry policy
MAX_RETRIES=2

# Confirmed live: running the sync browser headless gets flagged by BigSeller's bot
# detection and the session gets silently kicked mid-run. Keep this false (headed)
# unless you've separately verified headless stays logged in for your account.
BIGSELLER_HEADLESS=false

# TEMPORARY diagnostic switch for the still-unsolved ~30min session-expiry bug
# (see HANDOFF-SESSION-BUG.md). When true, logs status/url/Set-Cookie-names for
# bigseller.com/.pro document+xhr+fetch requests to logs/YYYY-MM-DD.log. Leave
# false for normal operation — remove this whole switch once the bug is fixed.
BIGSELLER_DEBUG_NETWORK=false
